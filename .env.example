# Copy to .env and edit locally, or use `edric setup` for hidden key input.
# Stay on Groq's Free Plan. AWS is disabled until explicitly configured.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CONTEXT7_API_KEY=

# Future provider adapters: skeletons only in this version.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
