# Copy to .env and edit locally, or use `edric setup` for hidden key input.
# Stay on Groq's Free Plan. AWS is disabled until explicitly configured.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CONTEXT7_API_KEY=

# AWS Bedrock: future adapter skeleton.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# Optional Ollama adapter; requires a running server and installed tool-capable model.
# Blank OLLAMA_MODEL uses qwen2.5-coder:7b. No model is downloaded by Edric.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
